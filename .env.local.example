# =============================================================
# Percurso — variáveis de ambiente
# Copie para .env.local e preencha. .env.local não vai para o git.
# =============================================================

# --- Supabase -------------------------------------------------
# Project Settings → Data API → Project URL / anon public key.
# Estas duas TÊM prefixo NEXT_PUBLIC_ de propósito: o browser precisa delas,
# e a anon key só funciona dentro do que as políticas de RLS permitem.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API Keys → service_role.
# Ignora RLS por completo. Usada SÓ pelo `npm run seed`, nunca no app.
# Jamais coloque prefixo NEXT_PUBLIC_ aqui — iria parar no bundle do browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Endereço público do site ---------------------------------
# Necessário em produção para o acesso com Google e para as tags de SEO
# (canonical, Open Graph, robots e sitemap). Atrás de proxy ou CDN os
# cabeçalhos podem trazer o host interno; sem esta URL, o provedor devolveria
# a pessoa num endereço que o navegador dela não alcança. Em desenvolvimento
# pode deixar vazio — o host da requisição basta para o OAuth e o SEO não deve
# publicar URLs de localhost.
NEXT_PUBLIC_SITE_URL=

# --- Camada de IA (roda só no servidor) ----------------------
# Duas APIs dividem o trabalho e uma cobre a outra (ver lib/ia.ts). Basta
# ter UMA das duas chaves para tudo funcionar:
#   - explicar questão do ENEM  → Gemini de 1ª, Claude de reserva
#   - corrigir redação          → Claude de 1ª, Gemini de reserva
# Sem nenhuma das duas, essas duas telas respondem com erro dizendo que
# falta a chave; o resto do site continua de pé.

# Anthropic — console.anthropic.com → API Keys. Paga.
ANTHROPIC_API_KEY=

# Google Gemini — aistudio.google.com/apikey. Tem camada gratuita sem cartão
# (~1.500 req/dia no flash). Atenção: no tier grátis o Google usa os prompts
# para treino — aqui só vão enunciados públicos de prova e redações de treino.
GEMINI_API_KEY=

# Opcional: troca o modelo do Gemini. Padrão: gemini-3.6-flash.
#   gemini-3.5-flash-lite → mais rápido e mais barato, qualidade menor
#   gemini-flash-latest   → acompanha a rotação do Google sozinho
# GEMINI_MODELO=gemini-3.6-flash

# Opcional, uma por tarefa. Padrão: auto.
#   auto      → ordem acima (1ª escolha e reserva), com fallback
#   gemini    → só Gemini
#   anthropic → só Claude
# IA_EXPLICACAO_PROVEDOR=auto
# IA_REDACAO_PROVEDOR=auto

# Modelo de reserva do Gemini, na MESMA chave. Quando o principal responde 503
# "high demand", a explicação tenta este antes de desistir — sobrecarga no
# Google é por modelo, não por conta. Opcional: o padrão já é um lite.
GEMINI_MODELO_RESERVA=
